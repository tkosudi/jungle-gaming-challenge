# Copie para .env (ignorado pelo Git) e troque todos os valores "change-me-*", ou gere o .env
# com segredos aleatórios: ./scripts/generate-env.sh. Nada aqui é credencial real.

# PostgreSQL
POSTGRES_DB=jungle
POSTGRES_USER=jungle
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432

# Keycloak
KEYCLOAK_PORT=8180
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin-password

# Client secrets do realm local (infra/keycloak/realm.json usa ${...} na importação).
# Os testes de integração leem os mesmos valores (ambiente ou .env).
PROVIDER_A_CLIENT_SECRET=change-me-provider-a-secret
PROVIDER_B_CLIENT_SECRET=change-me-provider-b-secret
INTERNAL_SERVICE_CLIENT_SECRET=change-me-internal-service-secret
# Identidades só de teste (audience errada e token de 2s); nunca em produção.
TEST_OTHER_AUDIENCE_CLIENT_SECRET=change-me-test-other-audience-secret
TEST_SHORT_LIVED_CLIENT_SECRET=change-me-test-short-lived-secret

# LocalStack / AWS SQS
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
# Credenciais AWS do LocalStack: o ID de 12 dígitos é o número da conta local; o LocalStack
# Community aceita qualquer segredo e não aplica IAM (ver ARCHITECTURE.md).
AWS_ACCESS_KEY_ID=000000000000
AWS_SECRET_ACCESS_KEY=change-me-localstack-secret
# Provedores aceitos na fila SQS de entrada (fronteira de confiança do broker).
SQS_TRUSTED_PROVIDERS=provider-a,provider-b

# Application
APP_PORT=8080

# Local Go execution outside Docker
# DATABASE_URL=postgres://jungle:<POSTGRES_PASSWORD>@localhost:5432/jungle?sslmode=disable
# HTTP_ADDR=:8080
# OIDC_ISSUER_URL=http://localhost:8180/realms/jungle
# OIDC_AUDIENCE=wagering-api
# OIDC_JWKS_URL is optional; inside Docker it points to http://keycloak:8080/... (see compose.yaml)
