# PostgreSQL
POSTGRES_DB=jungle
POSTGRES_USER=jungle
POSTGRES_PASSWORD=localdev-only
POSTGRES_PORT=5432

# Keycloak
KEYCLOAK_PORT=8180
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=local-admin-only

# LocalStack / AWS SQS
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1

# Application
APP_PORT=8080

# Local Go execution outside Docker
# DATABASE_URL=postgres://jungle:localdev-only@localhost:5432/jungle?sslmode=disable
# HTTP_ADDR=:8080
